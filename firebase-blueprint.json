{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Hands & Head product catalog entity",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "handle": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "vendor": { "type": "string" },
        "productType": { "type": "string" },
        "totalInventory": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Hands & Head customer and buyer entity",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "currency": { "type": "string" },
        "totalSpent": { "type": "number" },
        "totalOrders": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "country"]
    },
    "Order": {
      "title": "Order",
      "description": "Hands & Head order pipeline entity with JIT Cash-Lock status",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "total": { "type": "number" },
        "subtotal": { "type": "number" },
        "amountPaid": { "type": "number" },
        "currency": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending", "advance_50_pct", "refunded"] },
        "fulfillmentStatus": { "type": "string", "enum": ["fulfilled", "unfulfilled", "partial", "cutting"] },
        "status": { "type": "string", "enum": ["open", "cutting_authorized", "completed", "cancelled"] },
        "productionUnlockedAt": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "total", "status"]
    },
    "B2BDeal": {
      "title": "B2BDeal",
      "description": "Hands & Head B2B Deal Engine Pipeline Entity",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "country": { "type": "string" },
        "leadScore": { "type": "number" },
        "temperature": { "type": "string", "enum": ["HOT", "WARM", "COLD"] },
        "archetype": { "type": "string", "enum": ["CORPORATE ENTERPRISE", "REPEAT BUYER (3x+)", "BULK MERCHANDISE", "HIGH-TICKET LEATHER"] },
        "stage": { "type": "string", "enum": ["New Lead", "Qualified", "Contacted", "Interested", "Lookbook Sent", "Quotation Staged", "Negotiation", "50% Advance Paid", "JIT Cutting/Production", "Delivery & Closed"] },
        "totalAmountUsd": { "type": "number" },
        "amountPaidUsd": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "cutting_authorized", "closed", "stagnant", "killed"] },
        "productionUnlockedAt": { "type": "string" },
        "lastContactedAt": { "type": "string" },
        "lastStageChangedAt": { "type": "string" }
      },
      "required": ["companyName", "archetype", "stage"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security ledger recording JIT cutting authorizations and security events",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "orderId": { "type": "string" },
        "operatorUid": { "type": "string" },
        "amountPaid": { "type": "number" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string" },
        "result": { "type": "string", "enum": ["AUTHORIZED", "BLOCKED_LESS_THAN_50_PCT", "ERROR"] },
        "message": { "type": "string" }
      },
      "required": ["timestamp", "orderId", "operatorUid", "result"]
    },
    "PaymentLedgerEntry": {
      "title": "PaymentLedgerEntry",
      "description": "Append-only payment event record in /orders/{orderId}/paymentLedger",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["BANK_TT", "BKASH", "CASH"] },
        "referenceId": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "verifiedBy": { "type": "string" }
      },
      "required": ["amount", "method", "referenceId"]
    },
    "IdempotencyKey": {
      "title": "IdempotencyKey",
      "description": "Idempotency gate record preventing duplicate state transitions",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "orderId": { "type": "string" },
        "response": { "type": "object" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["key", "orderId", "response"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global Firestore products collection"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Global Firestore customers collection"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Global Firestore orders collection with JIT cutting protection"
    },
    "/orders/{orderId}/paymentLedger/{ledgerId}": {
      "schema": "PaymentLedgerEntry",
      "description": "Append-only immutable payment ledger subcollection"
    },
    "/deals/{dealId}": {
      "schema": "B2BDeal",
      "description": "B2B Deal Engine Pipeline collection"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable audit ledger collection"
    },
    "/idempotencyKeys/{key}": {
      "schema": "IdempotencyKey",
      "description": "Idempotency locks with 24-hour expiration"
    }
  }
}
