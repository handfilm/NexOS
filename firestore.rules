rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// HANDS & HEAD NEXUS — Unified Firestore Security Rules
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@(handsandhead\\.com|gmail\\.com)')
      );
    }

    // ── Connection Test Probe ──
    match /test/{testId} {
      allow read, write: if true;
    }

    // ── 1. Orders Collection & JIT Production Ledger ──
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      // ── Subcollections ──
      match /paymentLedger/{ledgerId} {
        allow read, write: if true;
      }

      match /factoryEscrowLedger/{trancheId} {
        allow read, write: if true;
      }
    }

    // ── 2. Audit Logs: Security and Authorization Events ──
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // ── 3. Idempotency Keys: Internal System Gate ──
    match /idempotencyKeys/{key} {
      allow read, write: if false;
    }

    // ── 4. Rate Limits: Internal Defense ──
    match /rateLimits/{callerId} {
      allow read, write: if false;
    }

    // ── 5. B2B Deals Pipeline Collection ──
    match /deals/{dealId} {
      allow read, write: if true;
    }

    // ── 6. Core Catalog, Customers & Commerce Collections ──
    match /products/{productId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /stores/{storeId} {
      allow read, write: if true;
    }

    match /collections/{id} {
      allow read, write: if true;
    }

    match /discounts/{id} {
      allow read, write: if true;
    }

    match /inventory/{id} {
      allow read, write: if true;
    }

    match /inventory_movements/{id} {
      allow read, write: if true;
    }

    match /activities/{id} {
      allow read, write: if true;
    }

    match /settings/{id} {
      allow read, write: if true;
    }

    match /factory_orders/{id} {
      allow read, write: if true;
    }

    match /clearance_vault/{id} {
      allow read, write: if true;
    }

    match /consignments/{id} {
      allow read, write: if true;
    }

    match /corporate_quotations/{id} {
      allow read, write: if true;
    }

    match /broadcast_campaigns/{id} {
      allow read, write: if true;
    }

    match /rfq_threads/{id} {
      allow read, write: if true;
    }

    match /rfqs/{id} {
      allow read, write: if true;
    }

    match /campaigns/{id} {
      allow read, write: if true;
    }

    match /suppliers/{id} {
      allow read, write: if true;
    }

    // ── 7. NEXOS Federated Catalog Ecosystem ──
    match /federated_catalog/{catalogId} {
      allow read, write: if true;
    }

    match /federated_catalog_private/{catalogId} {
      allow read, write: if false;
    }

    match /system_sync/{syncDocId} {
      allow read, write: if false;
    }
  }
}
