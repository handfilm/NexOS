rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// HANDS & HEAD NEXUS — Hardened Firestore Security Rules
// Master PIN Gateway, Idempotency, and Append-Only Ledger Enforcement
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@(handsandhead\\.com|gmail\\.com)')
      );
    }

    // ── 1. Orders Collection with JIT Cash-Lock Protection ──
    // Strict Guardrail: Direct client-side update modifying `status`, `runningTotalPaid`,
    // or `specVerification` is STRICTLY BLOCKED.
    // These fields, along with `productionUnlockedAt` and `totalAmountPaid`, can ONLY be mutated
    // server-side by the Firebase Admin SDK inside the 2nd-Gen Cloud Functions
    // (`authorizeCutting`, `recordPaymentEvent`, `markSpecVerified`).
    match /orders/{orderId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.status != 'cutting_authorized' &&
        !('productionUnlockedAt' in request.resource.data) &&
        !('totalAmountPaid' in request.resource.data) &&
        !('runningTotalPaid' in request.resource.data) &&
        !('specVerification' in request.resource.data);

      allow update: if isSignedIn() &&
        // STRICTLY BLOCK client-side updates modifying status, runningTotalPaid, or specVerification
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status',
          'runningTotalPaid',
          'totalAmountPaid',
          'specVerification',
          'productionUnlockedAt'
        ]);

      allow delete: if isAdmin();

      // ── Subcollection: /orders/{orderId}/paymentLedger ──
      // APPEND-ONLY IMMUTABLE LEDGER:
      // Clients may read verified ledger entries, but can NEVER create, update, or delete.
      // All ledger mutations MUST flow through the 2nd-Gen Cloud Function `recordPaymentEvent`.
      match /paymentLedger/{ledgerId} {
        allow read: if isSignedIn();
        allow create, update, delete: if false;
      }
    }

    // ── 2. Audit Logs: Completely Immutable Security Ledger ──
    // Read-only for authenticated admins.
    // Client SDK create, update, and delete are strictly forbidden (Admin SDK / Functions only).
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── 3. Idempotency Keys: Internal System Gate ──
    // Client SDKs cannot read, write, update, or delete idempotency keys directly.
    match /idempotencyKeys/{key} {
      allow read, write: if false;
    }

    // ── 4. Rate Limits: Internal Brute-Force Defense ──
    // Client SDKs cannot read, write, update, or delete rate limits directly.
    match /rateLimits/{callerId} {
      allow read, write: if false;
    }

    // ── 5. B2B Deals Pipeline Collection ──
    match /deals/{dealId} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.resource.data.status != 'cutting_authorized';
      allow delete: if isAdmin();
    }

    // ── 5. Core Catalog, Customers & Commerce Collections ──
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /customers/{customerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{uid} {
      allow read, write: if isSignedIn();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /collections/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /discounts/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /inventory/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /inventory_movements/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /activities/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /factory_orders/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /clearance_vault/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
