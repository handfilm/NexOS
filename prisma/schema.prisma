// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BondStatus {
  BONDED
  NON_BONDED
  UNKNOWN
}

model Supplier {
  id                 String     @id @default(cuid())
  companyName        String     @map("company_name")
  slug               String     @unique
  category           String     @default("Garments & RMG")
  productTypes       String[]   @default(["Knit", "Woven"]) @map("product_types")
  bondStatus         BondStatus @default(UNKNOWN) @map("bond_status")
  district           String
  hsCodes            String[]   @default([]) @map("hs_codes")
  verificationSource String?    @default("EPB") @map("verification_source")
  isVerified         Boolean    @default(true) @map("is_verified")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@index([companyName])
  @@index([district])
  @@index([bondStatus])
  @@index([slug])
  @@map("suppliers")
}
